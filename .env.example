# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OCR_PROVIDER="gemini"
OCR_MODEL="gemini-2.5-flash"
OCR_MAX_CONCURRENCY="3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database & Durable Document Storage Configuration
# PRODUCTION REQUIREMENT (NODE_ENV=production): DOCUMENT_STORAGE_DIR must be configured,
# writable, and must NOT point inside /tmp, /var/tmp, or any ephemeral temp directory.
DATABASE_PATH="./data/govjobs.db"
DOCUMENT_STORAGE_DIR=""

# Live Verification Runtime Configuration (bounded defaults)
OMNIHUB_LIVE_TIMEOUT_MS="15000"
OMNIHUB_LIVE_MAX_RETRIES="2"
OMNIHUB_LIVE_RETRY_BACKOFF_MS="500"

# Official Source Acquisition Runner Configuration (LOCAL | REMOTE | AUTO)
# PRODUCTION REQUIREMENT (NODE_ENV=production): Use RUNNER_MODE="REMOTE" with an external
# HTTPS OFFICIAL_ACQUISITION_WORKER_URL (never loopback) and a strong OFFICIAL_ACQUISITION_WORKER_TOKEN.
# RUNNER_MODE="LOCAL" is reported as a production blocker; AUTO fallback is marked unproven.
OFFICIAL_ACQUISITION_WORKER_URL=""
OFFICIAL_ACQUISITION_WORKER_TOKEN=""
RUNNER_MODE="AUTO"
OMNIHUB_REMOTE_WORKER_URL=""
OMNIHUB_REMOTE_WORKER_TOKEN=""

# Standalone Official Acquisition Worker Service Configuration
WORKER_EXECUTION_ENVIRONMENT="PRODUCTION_REMOTE"
WORKER_HOST="0.0.0.0"
WORKER_PORT="8080"
WORKER_REQUEST_TIMEOUT_MS="15000"
WORKER_CONNECT_TIMEOUT_MS="15000"
WORKER_MAX_RETRIES="2"
WORKER_RETRY_BACKOFF_MS="500"
WORKER_MAX_RESPONSE_MB="25"
WORKER_MAX_CONCURRENCY="4"

# WordPress Publishing Configuration (REST API /wp-json/wp/v2)
OMNIHUB_WP_URL=""
OMNIHUB_WP_USERNAME=""
OMNIHUB_WP_APP_PASSWORD=""
OMNIHUB_WP_DEFAULT_STATUS="draft"
OMNIHUB_WP_TIMEOUT_MS="15000"
OMNIHUB_WP_MAX_RETRIES="2"
OMNIHUB_WP_RETRY_BACKOFF_MS="500"

# Production Control API Security, Auth, CORS & Rate Limiting
# Set a strong random secret for CONTROL_APP_AUTH_TOKEN (never commit real secrets)
CONTROL_APP_AUTH_TOKEN=""
CONTROL_APP_READONLY_TOKEN=""
INTERNAL_TRUSTED_TOKEN=""
CORS_ALLOWED_ORIGINS="http://localhost:3000"
API_BODY_LIMIT="512kb"
API_RATE_LIMIT_WINDOW_MS="60000"
API_RATE_LIMIT_MAX_IP="120"
API_RATE_LIMIT_MAX_TOKEN="240"

# Scheduler Core & Reliability Configuration (manual | scheduled | continuous)
# PRODUCTION REQUIREMENT (NODE_ENV=production): Use "scheduled" or "continuous".
# Starting production with AUTOMATION_MODE="manual" disables automatic processing and marks readiness DEGRADED.
AUTOMATION_MODE="manual"
POLL_INTERVAL_SECONDS="60"
MAX_CONCURRENT_JOBS="2"
MAX_RETRIES="2"
RETRY_BACKOFF_MS="1000"
RETRY_MAX_BACKOFF_MS="300000"
JOB_LEASE_MS="300000"
HEARTBEAT_INTERVAL_MS="60000"


# Reverse proxy & readiness probes
# Number of trusted reverse-proxy hops in front of this app (0 = direct). Required behind nginx/Cloudflare/etc.
# otherwise per-IP rate limiting sees only the proxy IP.
TRUST_PROXY="0"
# Cache (seconds) for the outbound remote-worker / WordPress readiness probes served by public
# /api/health, /api/status and /api/ready. Default: 30 in production, 0 (off) elsewhere.
READINESS_CACHE_SECONDS=""

# Production startup policy (fail-closed)
# In NODE_ENV=production the server REFUSES to start unless: CONTROL_APP_AUTH_TOKEN >= 32 chars,
# OMNIHUB_WP_URL (if set) is https, CORS_ALLOWED_ORIGINS or APP_URL is set, GEMINI_API_KEY is set
# (OCR), and (RUNNER_MODE=REMOTE) the worker URL is https with a token.
# Set to "true" ONLY for staging to start anyway (a warning is logged).
ALLOW_DEGRADED_START="false"

# SQLite maintenance: scheduled online backups + retention (default ON in production)
# MAINTENANCE_ENABLED: "true" | "false" (unset = on in production, off otherwise)
MAINTENANCE_ENABLED=""
BACKUP_DIR="./backups"
# 0 disables backups
BACKUP_INTERVAL_HOURS="24"
BACKUP_KEEP_COPIES="7"
# Completed jobs, audit logs and OCR cache rows older than this are deleted in small batches.
# Note: deleting a completed job also forgets its dedupe_key; duplicate WordPress posts are still
# prevented by the deterministic WordPress identity + duplicate-check stages.
RETENTION_DAYS="90"
