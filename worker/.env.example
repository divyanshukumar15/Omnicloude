# Official Acquisition Worker — Production Environment Configuration
# Deploy behind an external HTTPS reverse proxy/Cloud Run/Container service (never loopback in production).
# OFFICIAL_ACQUISITION_WORKER_TOKEN must be set to a strong shared secret matching the central app.
NODE_ENV="production"
WORKER_HOST="0.0.0.0"
WORKER_PORT="8080"
OFFICIAL_ACQUISITION_WORKER_TOKEN=""
WORKER_REQUEST_TIMEOUT_MS="15000"
WORKER_CONNECT_TIMEOUT_MS="15000"
WORKER_MAX_RETRIES="2"
WORKER_RETRY_BACKOFF_MS="500"
WORKER_MAX_RESPONSE_MB="25"
WORKER_MAX_CONCURRENCY="4"
WORKER_EXECUTION_ENVIRONMENT="PRODUCTION_REMOTE"
